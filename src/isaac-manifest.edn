{:id      :isaac.provider.claude-code
 :version "0.1.13"
 :factory isaac.module.protocol/module

 :isaac/cli
 {:mcp-bridge {:usage     "mcp-bridge --turn ID --url URL"
               :summary   "stdio MCP server relaying to a process-owned listener"
               :namespace isaac.mcp-bridge.main
               :hosted    true}}

 :isaac.agent/llm-api
 {:claude-cli {:factory isaac.llm.api.claude-cli/make}}

 :isaac.http/route
 [{:method  :post
   :path    "/claude/turns/:id"
   :handler isaac.llm.mcp-route/handle
   :scope   :mcp}]

 :isaac.agent/provider-template
 {:claude-code {:template {:api                        "claude-cli"
                      :auth                       "none"
                      :command                    "claude"
                      :stream-supports-tool-calls false
                      :drives-tool-loop?          true}
           :schema   {:drives-tool-loop?
                      {:type        :boolean
                       :description "When true, claude-cli drives the tool loop (LoopDriver)."}}}}}
